// Copy this file to credentials.h and fill in your values
#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

#define SERVER_URL    "http://192.168.1.100:3000"
#define FACTORY_CODE  "SOUTHERNIOT-DEMO"

// Operator login: device returns to login screen after this many ms of no
// RFID activity in the operating screen. 0 disables the timeout.
#define INACTIVITY_TIMEOUT_MS  300000UL

// ── LoRaWAN OTAA (rak3212 build only; ignored by esp32dev) — AS923-1 on ChirpStack v4 ──
// LORA_DEV_EUI 0 = derive from the WiFi MAC (EUI-48 -> EUI-64 with FF:FE inserted), recommended:
// the backend then maps DevEUI <-> MAC <-> station with no extra registration data.
// LORA_APP_KEY all-zero = LoRaWAN disabled at runtime (a clean clone still builds and boots).
#define LORA_DEV_EUI   0x0000000000000000ULL
#define LORA_JOIN_EUI  0x0000000000000000ULL
#define LORA_APP_KEY   { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                         0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
